{
  "name": "dsh-longtask-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Long-task context guard for DeepSeek Harness: externalize bulky history to project files so long sessions keep running.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "id": "longtask-guard",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT"
}
